{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ANDROID_STORE": "google-play"
      }
    },
    "galaxy": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "galaxy",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ANDROID_STORE": "galaxy"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
