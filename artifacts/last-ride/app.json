{
  "expo": {
    "name": "LastRide",
    "slug": "last-ride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "last-ride",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1322",
    "ios": {
      "bundleIdentifier": "jp.lastride.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "CFBundleLocalizations": [
          "ja",
          "en"
        ],
        "NSAlarmKitUsageDescription": "LastRide uses alarms to help you leave in time for your last train, even when your iPhone is locked or silenced."
      }
    },
    "android": {
      "package": "jp.lastride.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#112238",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LastRide uses your location to find the nearest station and calculate walking time home.",
          "locationAlwaysAndWhenInUsePermission": "LastRide uses your location in the background during a night out to keep your nearest station, walking time, and leave-by reminders accurate.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "LastRide uses your location in the background during a night out to keep your nearest station, walking time, and leave-by reminders accurate.",
          "motionUsagePermission": "LastRide doesn’t use motion data. This text is required by the location features it’s built on, and the app never asks for this permission."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "eas": {
        "projectId": "da307cab-09bc-43d3-a0dd-79c836c4ef97"
      }
    },
    "owner": "lastride"
  }
}
