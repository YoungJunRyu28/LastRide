{
  "expo": {
    "name": "LastRide",
    "slug": "last-ride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "last-ride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nicholasroberts.lastride",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.nicholasroberts.lastride"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#112238",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LastRide uses your location to find the nearest station and calculate walking time home.",
          "locationAlwaysAndWhenInUsePermission": "LastRide uses your location in the background during a night out to keep your nearest station, walking time, and leave-by reminders accurate.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
