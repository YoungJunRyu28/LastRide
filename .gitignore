# dependencies
node_modules/

# server caches and API usage counts
.cache/

# build output
dist/
build/
*.tsbuildinfo
# zipped dist/, built fresh by scripts/deploy-lambda.sh — not source
lambda-deploy.zip

# Expo / native (ios/ and android/ are generated by `expo prebuild`).
# Local native modules keep their ios/ and android/ sources.
.expo/
ios/
android/
!artifacts/last-ride/modules/*/ios/
!artifacts/last-ride/modules/*/android/

# local tooling
.playwright-mcp/
.DS_Store

# env / secrets
# .env* on its own (was previously just ".env" and ".env*.local") — that left
# .env.production, .env.staging, etc. untracked by this pattern and therefore
# NOT excluded from git, which is exactly the kind of file meant to hold real
# secrets. If a committed example file is ever needed, name it .env.example
# and add a matching negation (!.env.example) below.
.env*
!.enc.example
*.p8
*.p12
*.key
*.mobileprovision

# Python tooling
__pycache__/
*.pyc
.aws-sam/

# Gradle caches (Android tooling, e.g. editor extensions syncing native modules)
.gradle/

# Filled-in legal forms hold personal details (address, phone): keep them in
# ~/Documents/LastRide-private/, never in the repo. Only the blank forms are tracked.
docs/legal/**/電気通信事業届出書.pdf
docs/legal/**/ネットワーク構成図.pdf
docs/legal/**/提供する電気通信役務.pdf
~$*
