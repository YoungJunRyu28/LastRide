# API server
PORT=8080
LOG_LEVEL=info
# Set to the number of trusted reverse-proxy hops in production (commonly 1).
# Leave 0 when the API is directly internet-facing.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lastride

# Transit/routing providers
# ODPT developer key, for building the own last-train engine's timetable
# snapshot (docs/last-train-engine.md).
ODPT_KEY=
# Optional: where the timetable snapshot that serves /api/trains/* lives.
# Default: next to the server bundle (dist/), else data/transit-snapshot.json.gz.
TRANSIT_SNAPSHOT_PATH=

# Public API abuse protection and private usage dashboard
PUBLIC_LOOKUP_RATE_LIMIT_PER_MINUTE=60
USAGE_ADMIN_TOKEN=replace-with-long-random-admin-token

# Expo Push Service enhanced security (enable Push Security in EAS for production)
EXPO_ACCESS_TOKEN=

# Groups (飲み会 groups). RevenueCat secret API key used to check the "premium"
# entitlement before a group is created. Empty = allow (dev/test only);
# production answers 503 without it.
REVENUECAT_SECRET_KEY=
# 32 random bytes (base64 or hex) so hosts can re-share the current invite.
# Empty uses a fixed dev key outside production; in production invites are then
# shown only when created/rotated.
GROUP_INVITE_ENCRYPTION_KEY=

# Organizer authentication (server-side) — only for LastRide for Business
# (deploy with ENABLE_BUSINESS=true).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Accounts listed here may bootstrap the first enterprise organization.
# Comma-separated. Leave empty in production after provisioning is complete.
ENTERPRISE_BOOTSTRAP_EMAILS=
ENTERPRISE_BOOTSTRAP_ORGANIZATION_NAME=LastRide Business

# Local-development organizer auth only. Never use a real production token here.
ENTERPRISE_DEV_BEARER_TOKEN=replace-with-long-random-dev-token
ENTERPRISE_DEV_AUTH_USER_ID=dev-organizer
ENTERPRISE_DEV_EMAIL=dev@lastride.local

# Expo app -> API server
EXPO_PUBLIC_API_URL=http://localhost:8080
# Development/testing only. Public OSM/Photon services are disabled in production by default.
EXPO_PUBLIC_ENABLE_COMMUNITY_FALLBACKS=false
# LastRide for Business (organizer events and alerts; consumer groups are
# separate). Not in v1: off unless set to true.
EXPO_PUBLIC_ENABLE_BUSINESS=false
# Premium (RevenueCat public SDK keys). Empty = test mode: premium is a local
# switch (Settings → demo section) and test purchases only work in dev builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Support contact shown with the ODPT data notice (licence condition: users
# must contact the app, not the rail companies). An email address or URL.
EXPO_PUBLIC_SUPPORT_CONTACT=
# Legal pages linked from the paywall (terms are required by App Review).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_TOKUSHOHO_URL=
# Train times: the server's ODPT timetable first; routes it doesn't cover (JR,
# private railways) use Apple Maps on iOS builds with modules/apple-maps, shown
# as 目安 when Apple's answer may be a walk. "server" turns Apple off.
EXPO_PUBLIC_TRANSIT_PROVIDER=
# Crash reporting (Sentry). Leave empty to disable; never active in development.
EXPO_PUBLIC_SENTRY_DSN=
# Source-map upload during EAS builds (SENTRY_AUTH_TOKEN goes in EAS secrets).
SENTRY_ORG=
SENTRY_PROJECT=

# Expo organizer OTP sign-in. These are intentionally public client values,
# not a Supabase service-role secret.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional HTTPS base used to share event links, e.g. https://lastride.example.
# Without this, the app uses the custom scheme last-ride://join.
EXPO_PUBLIC_APP_JOIN_BASE_URL=

# Local organizer shortcut used only in __DEV__ builds.
EXPO_PUBLIC_ENTERPRISE_DEV_BEARER_TOKEN=replace-with-same-dev-token
EXPO_PUBLIC_ENTERPRISE_DEV_EMAIL=dev@lastride.local

# Native build configuration
IOS_BUNDLE_ID=jp.lastride.app
# Apple signing team for local native builds (Xcode → Signing & Capabilities).
APPLE_TEAM_ID=
# iOS widget extension: Live Activity (lock-screen countdown) and home/lock
# widgets. Needs paid Apple signing (App Group).
ENABLE_LIVE_ACTIVITY=false
ANDROID_PACKAGE_ID=jp.lastride.app
ENABLE_REMOTE_PUSH=false

# Optional cache location for provider responses / usage tracking
CACHE_DIR=.cache
